{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=FinBudget;Username=FinBudget;Password=finbudget"
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "FamilyFinance.Api",
      "Audience": "FamilyFinance.Client",
      "AccessTokenMinutes": 15
    }
  },
  "ReceiptOcr": {
    "Provider": "Tesseract",
    "StoragePath": "App_Data/receipts",
    "MaxFileSizeBytes": 15728640,
    "MaxPdfPages": 20,
    "ProcessTimeoutSeconds": 90,
    "TesseractExecutable": "tesseract",
    "PdfToPpmExecutable": "pdftoppm",
    "TesseractLanguage": "spa+eng",
    "AzureEndpoint": "",
    "AzureApiKey": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
