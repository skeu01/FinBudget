@baseUrl = https://localhost:7001
@email = user@example.com
@password = StrongPassword123

### Register account
POST {{baseUrl}}/api/v1/auth/register
Content-Type: application/json

{
  "email": "{{email}}",
  "displayName": "Family User",
  "password": "{{password}}"
}

### Login; the refresh token is stored in an HttpOnly cookie
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### Refresh access token using the refresh cookie from Login
POST {{baseUrl}}/api/v1/auth/refresh

### Get current profile (replace access token with Login response value)
GET {{baseUrl}}/api/v1/auth/me
Authorization: Bearer {{accessToken}}

### Logout and revoke the refresh cookie
POST {{baseUrl}}/api/v1/auth/logout
