# Copy this file to .env and replace both secrets with unique values.
# Generate secure values with: openssl rand -hex 32
POSTGRES_DB=familyfinance
POSTGRES_USER=familyfinance
POSTGRES_PASSWORD=replace-with-a-unique-database-password

JWT_SIGNING_KEY=replace-with-a-unique-random-secret-of-at-least-32-characters
JWT_ISSUER=FamilyFinance.Api
JWT_AUDIENCE=FamilyFinance.Client
JWT_ACCESS_TOKEN_MINUTES=15

API_PORT=8080
FRONTEND_PORT=8081
POSTGRES_PORT=5432
VITE_API_BASE_URL=/api/v1

# Use Tesseract (default) or AzureDocumentIntelligence.
OCR_PROVIDER=Tesseract
OCR_AZURE_ENDPOINT=
OCR_AZURE_API_KEY=
